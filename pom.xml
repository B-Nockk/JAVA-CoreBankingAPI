<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- <version>4.0.3</version> -->
        <version>3.2.3</version> <!-- latest stable -->
        <relativePath/>
    </parent>

    <groupId>com.coreledger</groupId>
    <artifactId>coreledger-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>CoreLedger - Parent</name>
    <description>Core Banking Platform — Multi-module parent</description>

    <modules>
        <module>shared-kernel</module>
        <module>account-module</module>
        <module>transfer-module</module>
        <module>user-module</module>
        <module>app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- <springdoc.version>2.5.0</springdoc.version> -->
        <springdoc.version>2.3.0</springdoc.version>
        <!-- <springdoc.version>3.0.0</springdoc.version> -->

    </properties>

    <!--
        dependencyManagement: declares versions ONCE here.
        Child modules inherit these versions without specifying them.
        Nothing is actually added to any module unless that module
        explicitly declares the dependency in its own pom.xml.
    -->
    <dependencyManagement>
        <dependencies>
            <!-- Internal modules -->
            <dependency>
                <groupId>com.coreledger</groupId>
                <artifactId>shared-kernel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.coreledger</groupId>
                <artifactId>account-module</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.coreledger</groupId>
                <artifactId>transfer-module</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- OpenAPI / Swagger -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>1.18.30</version> <!-- latest stable -->
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>